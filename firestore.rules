rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProcurementItem(data) {
      return data.keys().hasAll(['id', 'ownerId', 'code', 'date', 'unit', 'type', 'category', 'itemName', 'quantity', 'unitMeasure', 'unitPrice', 'totalPrice', 'priority', 'status'])
        && data.keys().hasOnly(['id', 'ownerId', 'code', 'date', 'unit', 'type', 'category', 'itemName', 'spec', 'quantity', 'unitMeasure', 'unitPrice', 'totalPrice', 'priority', 'status', 'notes', 'vendor', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.code is string && data.code.size() <= 64
        && data.date is string && data.date.size() <= 32
        && data.unit is string && data.unit.size() <= 128
        && (data.type == 'Barang' || data.type == 'Jasa')
        && data.category is string && data.category.size() <= 128
        && data.itemName is string && data.itemName.size() <= 256
        && data.quantity is number && data.quantity >= 0
        && data.unitMeasure is string && data.unitMeasure.size() <= 64
        && data.unitPrice is number && data.unitPrice >= 0
        && data.totalPrice is number && data.totalPrice >= 0
        && (data.priority == 'Tinggi' || data.priority == 'Sedang' || data.priority == 'Rendah')
        && (data.status == 'Draft' || data.status == 'Diajukan' || data.status == 'Disetujui' || data.status == 'Proses Beli' || data.status == 'Selesai' || data.status == 'Ditolak')
        && (!('spec' in data) || (data.spec is string && data.spec.size() <= 1000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('vendor' in data) || (data.vendor is string && data.vendor.size() <= 256))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidProcurementSettings(data) {
      return data.keys().hasAll(['id', 'ownerId', 'fiscalYear'])
        && data.keys().hasOnly(['id', 'ownerId', 'fiscalYear', 'npsn', 'pemohonName', 'customLogo', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.fiscalYear is string && data.fiscalYear.size() <= 16
        && (!('npsn' in data) || (data.npsn is string && data.npsn.size() <= 32))
        && (!('pemohonName' in data) || (data.pemohonName is string && data.pemohonName.size() <= 128))
        && (!('customLogo' in data) || (data.customLogo is string && data.customLogo.size() <= 500000))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity test endpoint
    match /test/{testId} {
      allow get: if true;
    }

    // Procurement items collection
    match /procurement_items/{itemId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(itemId) && isValidProcurementItem(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(itemId) && isValidProcurementItem(incoming()) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(itemId) && existing().ownerId == request.auth.uid;
    }

    // Procurement settings collection
    match /procurement_settings/{settingsId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(settingsId) && isValidProcurementSettings(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(settingsId) && isValidProcurementSettings(incoming()) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(settingsId) && existing().ownerId == request.auth.uid;
    }
  }
}
